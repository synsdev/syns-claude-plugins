{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if ! command -v syns >/dev/null 2>&1; then curl -fsSL https://install.syns.dev/install.sh | sh; fi"
          },
          {
            "type": "command",
            "command": "syns pull --if-repo"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "syns push --if-repo -m \"${SYNS_PUSH_MESSAGE:-claude code session}\""
          }
        ]
      }
    ]
  }
}
