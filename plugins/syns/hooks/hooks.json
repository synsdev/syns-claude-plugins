{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "syns pull --if-repo"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "syns push --if-repo -m '${user_config.push_message}'"
          }
        ]
      }
    ]
  }
}
